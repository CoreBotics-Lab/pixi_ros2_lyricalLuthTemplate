{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ROS 2: Debug C++ Node (Prompt)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/install/${input:packageName}/lib/${input:packageName}/${input:executableName}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "QT_QPA_PLATFORM", "value": "xcb" },
                { "name": "QT_SCREEN_SCALE_FACTORS", "value": "1" },
                { "name": "QT_SCALE_FACTOR", "value": "1" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "sourceFileMap": {
                "${workspaceFolder}": "${workspaceFolder}"
            }
        },
        {
            "name": "ROS 2: Attach GDB to Process",
            "type": "cppdbg",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "ROS 2: Debug Python Node (Prompt)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/install/${input:packageName}/lib/${input:packageName}/${input:executableName}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: Debug Active File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ],
    "inputs": [
        {
            "id": "packageName",
            "type": "promptString",
            "description": "Package Name (e.g. my_robot_pkg)"
        },
        {
            "id": "executableName",
            "type": "promptString",
            "description": "Executable / Node Name (e.g. my_node)"
        }
    ]
}