{
  "configurations": [
    {
      "name": "ROS 2 Lyrical (Pixi)",
      "includePath": [
        "${workspaceFolder}/src/**/include/**",
        "${workspaceFolder}/install/**/include/**",
        "${workspaceFolder}/.pixi/envs/default/include/**"
      ],
      "compilerPath": "${workspaceFolder}/.pixi/envs/default/bin/g++",
      "cStandard": "c17",
      "cppStandard": "c++17",
      "intelliSenseMode": "linux-gcc-x64",
      "compileCommands": "${workspaceFolder}/build/compile_commands.json"
    }
  ],
  "version": 4
}